---
const { lang = 'en' } = Astro.props;

const links = [
  { code: 'en', label: '🇬🇧 English', href: '/' },
  { code: 'ru', label: '🇷🇺 Русский', href: '/ru/' },
  { code: 'zh', label: '🇨🇳 中文', href: '/zh/' },
];
---

<nav class="flex justify-end gap-4 p-4 text-sm">
  {links.map(({ code, label, href }) => (
    <a
      href={href}
      class={`hover:underline ${code === lang ? 'font-bold underline' : 'text-gray-500'}`}
    >
      {label}
    </a>
  ))}
</nav>
