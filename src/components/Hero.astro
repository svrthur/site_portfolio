---
const { lang = 'en' } = Astro.props;

const titles = {
  en: "Hi! I'm Arthur",
  ru: "Привет! Я Артур",
  zh: "你好！我是阿图尔"
};

const subtitles = {
  en: "Frontend Engineer & QA Specialist",
  ru: "Frontend-инженер и специалист по тестированию",
  zh: "前端工程师兼测试专家"
};
---

<section class="text-center py-12">
  <h1 class="text-5xl font-bold mb-4">{titles[lang]}</h1>
  <p class="text-xl text-gray-600">{subtitles[lang]}</p>
</section>
